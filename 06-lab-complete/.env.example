# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# .env đã nằm trong .gitignore — KHÔNG commit .env, KHÔNG ghi secret thật vào file này.

PORT=8000
ENVIRONMENT=development

# Tạo key ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(24))"
AGENT_API_KEY=change-me

# docker compose ghi đè giá trị này thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
